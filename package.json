{
  "name": "@momidala/legate",
  "version": "3.0.0",
  "type": "module",
  "description": "TypeScript MCP server that exposes OpenCode's HTTP API as Claude Code tools",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "build/",
    "scripts/",
    "README.md",
    "EXAMPLE_CLAUDE.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/momidala/legate.git"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js build/cli.js",
    "test": "tsc && node --test build/",
    "typecheck": "tsc --noEmit",
    "postinstall": "node ./scripts/lifecycle.cjs install-command",
    "preuninstall": "node ./scripts/lifecycle.cjs uninstall-command",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "bin": {
    "legate": "./build/cli.js",
    "legate-mcp": "./build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opencode-ai/sdk": "1.14.25",
    "diff": "^9.0.0",
    "proper-lockfile": "^4.1.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "@types/proper-lockfile": "^4.1.4",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  },
  "overrides": {
    "ip-address": "^10.2.0",
    "express-rate-limit": "^8.5.1",
    "@hono/node-server": "^2.0.5",
    "body-parser": "^2.2.3"
  }
}
